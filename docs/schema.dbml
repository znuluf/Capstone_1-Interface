Table "dbo"."FpmsPondBatches" {
  "Id" uniqueidentifier(16) [pk, not null]
  "CycleId" uniqueidentifier(16) [unique, not null]
  "PondId" uniqueidentifier(16) [unique, not null]
  "PreparationRoundId" uniqueidentifier(16) [unique]
  "Letter" nvarchar(2) [unique, not null]
  "BatchCode" nvarchar(50) [unique, not null]
  "Status" int(10) [not null]
  "StockedAtUtc" datetime2
  "StockingDate" date
  "PlCountStocked" bigint(19)
  "PondAreaM2AtStocking" decimal(10,2) [not null]
  "TransportMode" int(10) [not null]
  "TimeProcessedUtc" datetime2
  "AcclimationMinutes" int(10) [check: `[AcclimationMinutes] IS NULL OR [AcclimationMinutes]>=(0) AND [AcclimationMinutes]<=(600)`]
  "InitialSurvivalEstimatePct" decimal(5,2) [check: `[InitialSurvivalEstimatePct] IS NULL OR [InitialSurvivalEstimatePct]>=(0) AND [InitialSurvivalEstimatePct]<=(100)`]
  "HatcheryCertificationStatusAtStocking" nvarchar(500)
  "DeadAtStocking" bigint(19) [check: `[DeadAtStocking] IS NULL OR [DeadAtStocking]>=(0)`]
  "FarmingSystemAtStocking" int(10) [check: `[FarmingSystemAtStocking] IS NULL OR ([FarmingSystemAtStocking]=(3) OR [FarmingSystemAtStocking]=(2) OR [FarmingSystemAtStocking]=(1))`]
  "ConstructionTypeAtStocking" int(10) [check: `[ConstructionTypeAtStocking] IS NULL OR ([ConstructionTypeAtStocking]=(3) OR [ConstructionTypeAtStocking]=(2) OR [ConstructionTypeAtStocking]=(1))`]
  "DensityFlag" int(10) [check: `[DensityFlag] IS NULL OR ([DensityFlag]=(3) OR [DensityFlag]=(2) OR [DensityFlag]=(1))`]
  "FinalAbwG" decimal(8,3)
  "FinalFcr" decimal(8,3)
  "SurvivalRatePct" decimal(6,2)
  "TotalHarvestKg" decimal(14,3)
  "TotalFeedKg" decimal(14,3)
  "CultureDays" int(10)
  "ClosedAtUtc" datetime2
  "ClosedByUserId" bigint(19)
  "RowVersion" timestamp
  "CreationTime" datetime2 [not null]
  "CreatorUserId" bigint(19)
  "LastModificationTime" datetime2
  "LastModifierUserId" bigint(19)
  "IsDeleted" bit [not null]
  "DeleterUserId" bigint(19)
  "DeletionTime" datetime2
  "TenantId" int(10) [unique, not null]

  Checks {
    `[IsDeleted]=(1) OR [StockedAtUtc] IS NOT NULL AND [StockingDate] IS NOT NULL AND [PlCountStocked]>(0)` [name: 'CK_FpmsPondBatches_Stocking']
  }

  Indexes {
    CycleId [type: nonclustered, name: "IX_FpmsPondBatches_CycleId"]
